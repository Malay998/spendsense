NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Server-only. Never use NEXT_PUBLIC_ on this key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# Optional: comma-separated admin emails used only for initial setup guidance.
# Actual admin authorization is based on Supabase app_metadata.role.
